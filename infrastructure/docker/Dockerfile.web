# Multi-stage production Dockerfile for Sakura Web Frontend (Nginx static + PWA)
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN npm ci

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

RUN npm --workspace=@sakura/shared run build
RUN npm --workspace=@sakura/web run build

FROM nginx:alpine AS runner

COPY infrastructure/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/web/index.html /usr/share/nginx/html/index.html
COPY apps/web/public /usr/share/nginx/html/
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html/dist

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
