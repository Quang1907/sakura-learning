{
  "name": "@sakura/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend REST API for Sakura Swipe Learning",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsc --build && node dist/server.js",
