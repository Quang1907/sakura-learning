{
  "name": "sakura-swipe-learning",
  "version": "0.1.0",
  "private": true,
  "description": "Nền tảng học tiếng Nhật theo định dạng thẻ vuốt dọc",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "type-check": "tsc --build --verbose",
    "build": "tsc --build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "japanese-learning",
    "jlpt",
    "kanji",
    "srs",
    "swipe-feed",
    "mobile-first"
  ],
  "author": "Sakura Learning Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vitest": "^2.1.3"
  }
}
